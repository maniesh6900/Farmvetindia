# Farm Vet India — contact configuration (copy to .env and edit)
# WhatsApp / order number: digits only, with country code (91 = India).
VITE_WHATSAPP_NUMBER=919800000000

# Optional: how the number is displayed in the header/footer.
# If omitted, it is auto-formatted from VITE_WHATSAPP_NUMBER.
VITE_CONTACT_PHONE=+91 98000 00000

# Contact email shown in the footer/header.
VITE_CONTACT_EMAIL=hello@farmvetindia.in
